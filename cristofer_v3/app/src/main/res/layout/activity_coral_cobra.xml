<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cc_activity_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_lock_lock"
            android:tint="@color/cc_header_tint" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/cc_header"
            android:textColor="@color/cc_header_text"
            android:textSize="@dimen/cc_header_text_size"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tvStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cc_header_text"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:id="@+id/viewProgress"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/cc_screen_padding"
            android:paddingEnd="@dimen/cc_screen_padding"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cc_title"
                android:textColor="@color/cc_text_primary"
                android:textStyle="bold"
                android:textSize="@dimen/cc_title_text_size_max"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cc_desc"
                android:textColor="@color/cc_text_primary"
                android:textSize="@dimen/cc_desc_text_size"
                android:lineSpacingExtra="2dp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardIllustration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/cc_card_bg"
                app:cardCornerRadius="@dimen/cc_card_corner"
                app:cardElevation="0dp">

                <LinearLayout
                    android:id="@+id/llAccessibilityIllustration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="@dimen/cc_mock_phone_width"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="6dp"
                        android:background="@drawable/phone_mock_frame">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12:00"
                            android:textColor="@color/cc_text_secondary"
                            android:textSize="@dimen/cc_mock_body_text_size" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/cc_mock_title"
                            android:textColor="@color/cc_text_primary"
                            android:textSize="@dimen/cc_mock_title_text_size"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="4dp"
                            android:background="@color/cc_phone_divider" />

                        <View android:layout_width="80dp" android:layout_height="4dp" android:layout_marginTop="6dp" android:background="@color/cc_phone_bar_dark" />
                        <View android:layout_width="60dp" android:layout_height="4dp" android:layout_marginTop="5dp" android:background="@color/cc_phone_bar_light" />
                        <View android:layout_width="90dp" android:layout_height="4dp" android:layout_marginTop="5dp" android:background="@color/cc_phone_bar_dark" />
                        <View android:layout_width="70dp" android:layout_height="4dp" android:layout_marginTop="5dp" android:background="@color/cc_phone_bar_light" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="8dp"
                            android:background="@color/cc_phone_divider" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="4dp"
                            android:background="@color/cc_phone_surface"
                            android:elevation="2dp">

                            <View
                                android:layout_width="@dimen/cc_mock_icon_size"
                                android:layout_height="@dimen/cc_mock_icon_size"
                                android:background="@color/cc_phone_icon_bg"
                                android:layout_marginEnd="4dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvMockAppName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/app_name"
                                    android:textColor="@color/cc_text_primary"
                                    android:textSize="@dimen/cc_mock_body_text_size"
                                    android:lineSpacingExtra="-1dp" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="@dimen/cc_mock_toggle_w"
                                android:layout_height="@dimen/cc_mock_toggle_h"
                                android:src="@drawable/mock_toggle_off" />
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStep1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cc_step_1"
                            android:textColor="@color/cc_text_primary"
                            android:textSize="@dimen/cc_step_text_size"
                            android:lineSpacingExtra="2dp" />

                        <TextView
                            android:id="@+id/tvStep2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:textColor="@color/cc_text_primary"
                            android:textSize="@dimen/cc_step_text_size"
                            android:lineSpacingExtra="2dp" />

                        <TextView
                            android:id="@+id/tvStep3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/cc_step_3"
                            android:textColor="@color/cc_text_primary"
                            android:textSize="@dimen/cc_step_text_size"
                            android:textStyle="italic"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/llReasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="#B71C1C"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/llStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/status_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/cc_button_bg" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:textColor="@color/cc_button_bg"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cc_activity_bg"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <Button
            android:id="@+id/btnAction"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cc_button_height"
            android:background="@drawable/primary_button_bg"
            android:text="@string/cc_button"
            android:textColor="@color/cc_button_text"
            android:textSize="@dimen/cc_button_text_size"
            android:textStyle="bold"
            android:letterSpacing="0.04" />
    </LinearLayout>

</LinearLayout>
